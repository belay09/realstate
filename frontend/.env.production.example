# Public API URL (built into the static bundle at image build time)
VITE_API_BASE_URL=https://habesha-homes.com/api/v1
VITE_SITE_URL=https://habesha-homes.com
# After Google Search Console setup, paste verification token:
# VITE_GOOGLE_SITE_VERIFICATION=your-google-verification-code
# VITE_CONTACT_EMAIL=info@habesha-homes.com
# VITE_WHATSAPP_E164=251962750710

# Cloudinary upload (admin media uploader)
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
